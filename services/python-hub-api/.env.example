# Stellera Hub API 本地开发环境变量。
# 复制为 .env 后按需修改；.env 已被 .gitignore 忽略，不要提交。
#
#   cp .env.example .env
#
# 同时作为 compose.yml 的默认变量来源；示例密码/JWT_SECRET 只适合本机开发。

# ---------- 运行环境 ----------
APP_ENV=development
# 调试子开关，逗号分隔；目前支持 db_echo（打印 SQL），默认空。
DEBUG=
DOCS_ENABLED=true

# ---------- 数据库 ----------
# 宿主机直接运行时使用；容器内的 DATABASE_URL 由 compose.yml 按 DB_* 组装。
DATABASE_URL=postgresql+asyncpg://hub:hub_dev_password@localhost:5432/hub

# ---------- JWT ----------
JWT_SECRET=local-dev-only-change-me-32-characters-min
JWT_ISSUER=stellera-hub
JWT_AUDIENCE=stellera-hub-web
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

# ---------- HTTP ----------
# 逗号分隔；Vite 开发服务器与 nginx 站点地址。
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

# ---------- 初始化 job（app.scripts.init） ----------
# 系统超级管理员账号；生产环境必须替换密码。
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin12345

# ---------- 容器（compose.yml） ----------
# 容器内 DATABASE_URL 由 DB_* 拼装；指向外部库时改 DB_HOST / DB_PORT。
DB_HOST=local-db
DB_PORT=5432
DB_USER=hub
DB_PASSWORD=hub_dev_password
DB_NAME=hub
# 本地库映射到宿主机的端口（容器内始终 5432）。
DB_HOST_PORT=5432

# 宿主机映射；容器监听 PORT，worker 数由 WEB_CONCURRENCY 控制。
API_BIND=127.0.0.1
API_PORT=8000
PORT=8000
WEB_CONCURRENCY=1

# 镜像与构建（内网代理 / uv 索引；留空使用官方地址；配置索引时构建会按镜像源重写锁文件）。
PYTHON_IMAGE=python:3.13-slim
UV_IMAGE=ghcr.io/astral-sh/uv:latest
UV_DEFAULT_INDEX=
UV_EXTRA_INDEX_URL=
UV_INSECURE_HOST=
