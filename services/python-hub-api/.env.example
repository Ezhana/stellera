# Stellera Hub API 本地开发环境变量。
# 复制为 .env 后按需修改；.env 已被 .gitignore 忽略，不要提交。
#
#   cp .env.example .env
#
# 变量名与 infra/compose.yaml 保持一致；示例密码/JWT_SECRET 只适合本机开发。

# ---------- 运行环境 ----------
APP_ENV=development
DEBUG=true
DOCS_ENABLED=true

# ---------- 数据库（本地只起 db 容器时） ----------
DATABASE_URL=postgresql+asyncpg://hub:hub_dev_password@localhost:5432/hub
DATABASE_ECHO=false

# ---------- JWT ----------
# 至少 32 个字符；非 development 环境会拒绝示例值。
JWT_SECRET=local-dev-only-change-me-32-characters-min
JWT_ISSUER=stellera-hub
JWT_AUDIENCE=stellera-hub-web
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

# ---------- HTTP ----------
# 逗号分隔；Vite 开发服务器与 nginx 站点地址。
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

# ---------- 种子数据 ----------
# admin 一定会创建；operator / viewer 仅在 SEED_DEMO_USERS=true 时创建。
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin12345
SEED_ADMIN_EMAIL=admin@example.com
SEED_DEMO_USERS=true
SEED_OPERATOR_PASSWORD=operator12345
SEED_VIEWER_PASSWORD=viewer12345
