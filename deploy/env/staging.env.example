# Stellera Hub 测试环境（staging）部署变量模板。
#
# 首次部署（在仓库根目录执行）：
#   1. mkdir -p deploy/.state/backups
#   2. cp deploy/env/staging.env.example deploy/env/staging.env && chmod 600 deploy/env/staging.env
#   3. just gen-secret 16   # 生成 POSTGRES_PASSWORD（32 位十六进制）
#      just gen-secret 32   # 生成 JWT_SECRET（64 位十六进制）
#      把输出分别粘贴到下面 POSTGRES_PASSWORD= / JWT_SECRET=（等号左边不变）
#   4. 按需修改 WEB_PORT / CORS_ORIGINS / 镜像代理 / pip 源 / npm 源
#   5. just deploy staging
#
# 约定：
#   - 本文件只写纯 KEY=VALUE（没有命令替换、引号、分号），compose 按字面读取；
#   - 真实 env 含密钥，不提交：.gitignore 已忽略 deploy/env/*.env，只保留 *.example；
#   - RELEASE_VERSION（镜像 tag）由 justfile 从 git describe 注入，不要写进本文件。
#
# 发布/运维命令全部在仓库根目录通过 just 触发（环境参数默认 staging）：
#   just deploy staging / rollback / up / down / status / logs / backup / restore
#   just migrate / seed / smoke

# ---------- 部署编排 ----------
DEPLOY_ENV=staging
# 同一台机器跑多个环境时，project name 必须不同，否则会互相覆盖容器/数据卷。
COMPOSE_PROJECT_NAME=stellera-hub-staging
# 镜像名前缀；最终镜像为 <IMAGE_PREFIX>-hub-api:<RELEASE_VERSION>（api/web）
# 与 <IMAGE_PREFIX>-hub-ops:<OPS_IMAGE_TAG>（备份/恢复工具镜像）。
IMAGE_PREFIX=stellera

# ---------- 访问入口 ----------
# 测试环境唯一对外开放的入口：http://<测试机 IP 或域名>:${WEB_PORT}
WEB_BIND=0.0.0.0
WEB_PORT=8080
# API 默认只绑本机回环，避免 Swagger 直接暴露；需要外部访问时改成 0.0.0.0。
API_BIND=127.0.0.1
API_PORT=8000

# ---------- PostgreSQL ----------
POSTGRES_USER=hub
# 必填：留空会由 docker compose 直接报错拒绝启动。
# 用 `just gen-secret 16` 生成 32 位十六进制串后粘贴（十六进制天然是 URL 安全字符，
# 可安全拼进 DATABASE_URL）；不要手写含 @ : / ? # % 的密码。
POSTGRES_PASSWORD=
POSTGRES_DB=hub

# ---------- 运行环境 ----------
APP_ENV=staging
DEBUG=false
# 测试环境默认关闭 /docs 与 /openapi.json；要看 Swagger 时可临时改 true 并放开 API_BIND。
# 后端 Settings 启动即校验：非 development 环境 JWT_SECRET 过短 / 仍是占位值会直接起不来。
DOCS_ENABLED=false

# ---------- JWT ----------
# 必填：留空会由 docker compose 直接报错拒绝启动；至少 32 个字符。
# 用 `just gen-secret 32` 生成 64 位十六进制串后粘贴。
JWT_SECRET=
JWT_ISSUER=stellera-hub
JWT_AUDIENCE=stellera-hub-web
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

# ---------- HTTP / CORS ----------
# 逗号分隔。同源访问（浏览器直接访问 web 入口）其实不需要 CORS，
# 但这里写明测试入口，避免以后配成 *。把地址换成测试机实际 IP / 域名。
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# ---------- 种子数据 ----------
# 测试环境按需求保留弱口令演示账号与 10 条 FDE 演示订单（FDE-DEMO-0001 … 0010），
# 方便测试人员直接登录体验。仅限内网测试环境，绝不能用于生产！
# 生产环境必须：SEED_DEMO_USERS=false，并替换下面所有密码。
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin12345
SEED_ADMIN_EMAIL=admin@example.com
SEED_DEMO_USERS=true
SEED_OPERATOR_PASSWORD=operator12345
SEED_VIEWER_PASSWORD=viewer12345
SEED_ENTERPRISE_PASSWORD=enterprise12345
SEED_ENGINEER_PASSWORD=engineer12345

# ---------- 备份 ----------
# 备份目录（宿主侧），必须是可写目录；首次部署前先 mkdir -p deploy/.state/backups。
# 相对路径按 deploy/docker-compose/ 解析，默认 ../.state/backups = deploy/.state/backups；
# 也可写绝对路径（不支持 ~）。备份/恢复的文件都出现在这里。
BACKUP_HOST_DIR=../.state/backups
# 备份/恢复容器以该 UID:GID 运行，避免 Linux 上产出 root 属主文件。
# Linux 测试机请改成宿主机实际用户：HOST_UID=$(id -u)、HOST_GID=$(id -g)（注意换成数字）。
# macOS / Docker Desktop 下保持 1000 即可（文件属主由 Docker Desktop 虚拟化）。
HOST_UID=1000
HOST_GID=1000
# 自动清理超过该天数的备份（按文件名前缀 <DEPLOY_ENV>- 匹配，>0 才生效）。
BACKUP_KEEP_DAYS=14

# ---------- 一次性任务工具镜像（可选）----------
# 备份/恢复用的 ops 镜像 tag：不随发布版本走，改了 deploy/ops/ 下的脚本后重新
# `just deploy <env>`（内部会 --profile ops build）即可刷新。默认 local。
OPS_IMAGE_TAG=local

# ---------- 镜像覆盖（内网/镜像加速时使用）----------
# 测试机不能直连 Docker Hub / ghcr.io 时，把镜像换成内网代理地址；
# 保持注释则使用 compose.yaml 里的官方默认值。
# UV_IMAGE 默认 ghcr.io/astral-sh/uv:latest；需要完全可复现的构建时可覆盖成具体版本。
# POSTGRES_IMAGE=postgres:18
# PYTHON_IMAGE=python:3.13-slim
# UV_IMAGE=ghcr.io/astral-sh/uv:latest
# NODE_IMAGE=node:24-alpine
# NGINX_IMAGE=nginx:1.29-alpine

# ---------- pip 源（构建 api 镜像时生效）----------
# 测试机不能直连 PyPI 时配置，留空则使用官方 PyPI；
# uv 会把它们映射为 UV_DEFAULT_INDEX / UV_EXTRA_INDEX_URL / UV_INSECURE_HOST。
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# PIP_EXTRA_INDEX_URL=
# http 源需填写放行的主机（host 或 host:port，不带 http://）。
# PIP_TRUSTED_HOST=

# ---------- npm / corepack 源（构建 web 镜像时使用）----------
# 测试机不能直连 npm registry 时配置，留空则使用官方 registry。
# COREPACK_NPM_REGISTRY 是 corepack 下载 pnpm 用的源，留空时复用 NPM_REGISTRY。
# NPM_REGISTRY=https://registry.npmmirror.com
# COREPACK_NPM_REGISTRY=https://registry.npmmirror.com
