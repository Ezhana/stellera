# Stellera Hub 测试环境（staging）部署变量模板。
#
# 首次部署：
#   deploy/scripts/init-env.sh --env staging
#   # 生成 deploy/env/staging.env（已 chmod 600），并自动填好 JWT_SECRET / POSTGRES_PASSWORD；
#   # 然后按需修改本文件里的 WEB_PORT / CORS_ORIGINS 等。
#
# 也可以手工复制：
#   cp deploy/env/staging.env.example deploy/env/staging.env && chmod 600 deploy/env/staging.env
# 但必须替换 JWT_SECRET 与 POSTGRES_PASSWORD 的占位值，否则 deploy.sh 会拒绝启动。
#
# 真实 env 文件含密钥，不提交（.gitignore 已忽略 deploy/env/*.env，只保留 *.example）。

# ---------- 部署编排 ----------
DEPLOY_ENV=staging
# 同一台机器跑多个测试环境时，project name 必须不同，否则会互相覆盖容器/数据卷。
COMPOSE_PROJECT_NAME=stellera-hub-staging
# 镜像名前缀；最终镜像为 <IMAGE_PREFIX>-hub-api:<RELEASE_VERSION> 与 -hub-web:<RELEASE_VERSION>。
IMAGE_PREFIX=stellera

# ---------- 访问入口 ----------
# 测试环境对外入口：http://<测试机 IP 或域名>:${WEB_PORT}
WEB_BIND=0.0.0.0
WEB_PORT=8080
# API 默认只绑本机回环，避免 Swagger 直接暴露；需要外部访问时改成 0.0.0.0。
API_BIND=127.0.0.1
API_PORT=8000

# ---------- PostgreSQL ----------
POSTGRES_USER=hub
# init-env.sh 会生成为 32 位十六进制串；手工填写时请只使用 URL 安全字符
# （A-Z a-z 0-9 - _ .），否则会破坏 compose 里的 DATABASE_URL。
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_DB=hub

# ---------- 运行环境 ----------
APP_ENV=staging
DEBUG=false
# 测试环境默认关闭 /docs 与 /openapi.json；要看 Swagger 时可临时改 true 并放开 API_BIND。
DOCS_ENABLED=false

# ---------- JWT ----------
# 至少 32 个字符；APP_ENV 非 development 时服务端会拒绝示例值。
JWT_SECRET=replace-with-openssl-rand-hex-32
JWT_ISSUER=stellera-hub
JWT_AUDIENCE=stellera-hub-web
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

# ---------- HTTP / CORS ----------
# 逗号分隔。同源访问（浏览器直接访问 web 入口）其实不需要 CORS，
# 但这里写明测试入口，避免以后配成 *。把 <测试机地址> 换成实际 IP 或域名。
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# ---------- 种子数据 ----------
# 测试环境按需求保留弱口令演示账号与 10 条 FDE 演示订单（FDE-DEMO-0001 … 0010），
# 方便测试人员直接登录体验。仅限内网测试环境，绝不能用于生产！
# 生产环境必须：SEED_DEMO_USERS=false，并替换下面所有密码。
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin12345
SEED_ADMIN_EMAIL=admin@example.com
SEED_DEMO_USERS=true
SEED_OPERATOR_PASSWORD=operator12345
SEED_VIEWER_PASSWORD=viewer12345
SEED_ENTERPRISE_PASSWORD=enterprise12345
SEED_ENGINEER_PASSWORD=engineer12345

# ---------- 备份 ----------
# 每次发布前自动 pg_dump 到 deploy/.state/backups（生产环境建议同步到异地）。
BACKUP_BEFORE_DEPLOY=true
# 相对路径按 deploy/ 解析；也可写绝对路径。
BACKUP_DIR=.state/backups
# 自动清理超过该天数的备份文件。
BACKUP_KEEP_DAYS=14

# ---------- 镜像覆盖（内网/镜像加速时使用）----------
# 测试机不能直连 Docker Hub / ghcr.io 时，把镜像换成内网代理地址；
# 留空或注释掉则使用官方 tag（默认值见 compose.yaml 的 build.args / image）。
# UV_IMAGE 固定到具体版本（与 Dockerfile 默认一致），不要用 latest：
# 不同 uv 版本的锁文件校验行为可能不同，会报 "The lockfile ... needs to be updated"。
# POSTGRES_IMAGE=postgres:18
# PYTHON_IMAGE=python:3.13-slim
# UV_IMAGE=ghcr.io/astral-sh/uv:0.13.6
# NODE_IMAGE=node:24-alpine
# NGINX_IMAGE=nginx:1.29-alpine
