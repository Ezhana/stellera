# 复制为 deploy/.env 后填写：cp deploy/.env.example deploy/.env
#
# 本文件只放部署共享配置与 hub-api / web 的配置；
# PostgreSQL、Redis、LLM 网关等基础设施的专属配置在 infra/ 各子项目 .env 中，
# 这里不再重复定义（见 infra/README.md）。
COMPOSE_PROJECT_NAME=stellera
TZ=Asia/Shanghai
IMAGE_TAG=latest

# LLM 网关二选一：new-api 或 litellm（与 infra/.env 中的选择一致即可）
COMPOSE_PROFILES=new-api

# 必填：JWT_SECRET 用 just gen-secret 32
JWT_SECRET=

# hub-api 数据库连接串（hub 账号由 postgres-provision 一次性 job 创建，
# 密码必须与 infra/postgres/secrets/hub_db_password 文件内容一致）
HUB_DATABASE_URL=postgresql+asyncpg://hub:hub_dev_password@postgres:5432/hub

# Web 入口
WEB_PORT=8080
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# 一次性初始化 job：INIT_ARGS=--demo 时额外写入演示账号与订单
INIT_ARGS=
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin12345

# 基础设施配置（数据库/Redis/网关/观测栈）见各子项目 .env.example：
#   infra/postgres/.env.example  infra/redis/.env.example
#   infra/new-api/.env.example   infra/litellm/.env.example
#   infra/monitoring/prometheus/.env.example  infra/monitoring/grafana/.env.example
# 应用数据库密码见 infra/postgres/secrets/README.md（compose secret，postgres-provision job 使用）

# 内网构建镜像源（留空用官方源）
# UV_DEFAULT_INDEX=https://pypi.tuna.tsinghua.edu.cn/simple
# NPM_REGISTRY=https://registry.npmmirror.com
# COREPACK_NPM_REGISTRY=https://registry.npmmirror.com
