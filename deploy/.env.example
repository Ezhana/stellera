# 复制为 deploy/.env 后填写：cp deploy/.env.example deploy/.env
COMPOSE_PROJECT_NAME=stellera
TZ=Asia/Shanghai
IMAGE_TAG=latest

# 必填：POSTGRES_PASSWORD 用 just gen-secret 16，JWT_SECRET 用 just gen-secret 32
POSTGRES_PASSWORD=
JWT_SECRET=

# Web 入口
WEB_PORT=8080
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# 一次性初始化 job：INIT_ARGS=--demo 时额外写入演示账号与订单
INIT_ARGS=
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin12345

# PostgreSQL / Redis / new-api（infra/compose.yaml 消费）
POSTGRES_USER=stellera
POSTGRES_DB=stellera
POSTGRES_DBS=new-api,hub
REDIS_PASSWORD=redis
SQL_DSN=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/new-api
REDIS_CONN_STRING=redis://:${REDIS_PASSWORD}@redis:6379

# 内网构建镜像源（留空用官方源）
# UV_DEFAULT_INDEX=https://pypi.tuna.tsinghua.edu.cn/simple
# NPM_REGISTRY=https://registry.npmmirror.com
# COREPACK_NPM_REGISTRY=https://registry.npmmirror.com
