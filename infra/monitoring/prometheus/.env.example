# 复制为 infra/monitoring/prometheus/.env：
#   cp infra/monitoring/prometheus/.env.example infra/monitoring/prometheus/.env
# 只有启用观测栈（observability profile）时才需要。

PROMETHEUS_PORT=9090
# TSDB 保留时长
# PROMETHEUS_RETENTION=15d

# 抓取 LiteLLM /metrics 的 Bearer token；
# 值必须与 infra/litellm/.env 的 LITELLM_MASTER_KEY 一致。
LITELLM_METRICS_TOKEN=sk-change-me-litellm-master-key

# PROMETHEUS_IMAGE=prom/prometheus:latest
