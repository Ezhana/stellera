# 复制为 infra/monitoring/grafana/.env：
#   cp infra/monitoring/grafana/.env.example infra/monitoring/grafana/.env
# 只有启用观测栈（observability profile）时才需要。

GRAFANA_PORT=3001

# Grafana 容器环境变量（GF_* 会由 env_file 注入容器）
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me-grafana-admin-password
GF_USERS_ALLOW_SIGN_UP=false

# Grafana 后端数据库使用 PostgreSQL（grafana 库/账号由 postgres-provision job 创建，
# 密码来自 infra/postgres/secrets/grafana_db_password，由 compose secret 注入）。
GF_DATABASE_TYPE=postgres
GF_DATABASE_HOST=postgres:5432
GF_DATABASE_NAME=grafana
GF_DATABASE_USER=grafana
GF_DATABASE_SSL_MODE=disable

# GRAFANA_IMAGE=grafana/grafana:latest
