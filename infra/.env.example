# Stellera Hub 本地 Docker 环境变量。
# 复制为 .env 后按需修改；.env 已被 .gitignore 忽略，不要提交。
#
#   cp .env.example .env
#
# 注意：下面的密码与 JWT_SECRET 只适合本机开发/演示，绝不能用于生产。

# ---------- PostgreSQL ----------
POSTGRES_USER=hub
POSTGRES_PASSWORD=hub_dev_password
POSTGRES_DB=hub
POSTGRES_PORT=5432

# ---------- 端口 ----------
API_PORT=8000
WEB_PORT=8080

# ---------- JWT ----------
# 至少 32 个字符；非 development 环境下服务会拒绝示例值。
JWT_SECRET=local-dev-only-change-me-32-characters-min
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

# ---------- HTTP ----------
# 逗号分隔；Vite 开发服务器与 nginx 站点地址。
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
DOCS_ENABLED=true

# ---------- 种子数据 ----------
# admin 一定会创建；operator / viewer 仅在 SEED_DEMO_USERS=true 时创建。
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin12345
SEED_ADMIN_EMAIL=admin@example.com
SEED_DEMO_USERS=true
SEED_OPERATOR_PASSWORD=operator12345
SEED_VIEWER_PASSWORD=viewer12345

# ---------- 镜像覆盖（Docker Hub 不可直连时使用） ----------
# 本机可能已把这些镜像以代理前缀缓存；把实际地址填在这里即可，不需要改 compose。
# POSTGRES_IMAGE=postgres:18
# PYTHON_IMAGE=python:3.13-slim
# NODE_IMAGE=node:24-alpine
# NGINX_IMAGE=nginx:1.29-alpine
